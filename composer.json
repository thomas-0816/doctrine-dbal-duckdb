{
    "name": "thomas-0816/doctrine-dbal-duckdb",
    "description": "Doctrine DBAL driver for DuckDB, powered by the PHP PDO Driver for DuckDB",
    "keywords": ["doctrine", "dbal", "duckdb", "database", "analytics", "pdo"],
    "license": "MIT",
    "authors": [
        {
            "name": "Thomas Bley"
        }
    ],
    "require": {
        "php": ">= 8.2",
        "ext-pdo_duckdb": "*",
        "doctrine/dbal": "^4.4"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3",
        "phpunit/phpunit": "^11 || ^12 || ^13",
        "phpstan/phpstan": "*",
        "phpunit/php-code-coverage": "^11 || ^12 || ^13 || ^14"
    },
    "autoload": {
        "psr-4": {
            "DuckDb\\DBAL\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "phpcsfixer": "vendor/bin/php-cs-fixer fix --dry-run --allow-risky=yes --diff",
        "phpcsfixer_fix": "vendor/bin/php-cs-fixer fix --allow-risky=yes --diff",
        "phpstan": "vendor/bin/phpstan analyse",
        "phpunit": "vendor/bin/phpunit --coverage-text --coverage-html=.phpunit.coverage",
        "test": ["@phpcsfixer", "@phpstan", "@phpunit"],
        "test_fix": ["@phpcsfixer_fix", "@phpstan", "@phpunit"]
    }
}
